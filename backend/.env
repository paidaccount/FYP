# Project Settings
PROJECT_NAME="VANET Misbehavior Detection & Trust Management System"
API_V1_STR="/api/v1"

# Security Configurations
SECRET_KEY="super_secure_development_secret_key_change_in_production_key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 Days in minutes

# Database Configurations (PostgreSQL + PostGIS)
DATABASE_URL="postgresql+asyncpg://postgres:postgres_secure_pass@db:5432/vanet_db"

# Redis Cache Configurations
REDIS_URL="redis://redis:6379/0"

# Firebase Cloud Messaging Placeholder API key
FIREBASE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "vanet-firebase-project"}'

# Google Maps SDK API key
GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsAPIKeyHerePlaceholder"
